<?xml version="1.0" encoding="utf-8"?>
<!-- Colors are the Ink Blue dark tokens (surface, foreground, muted) from web
     DESIGN.md / lib/theme/tokens.dart.
     T056 status widget content (also the initialLayout — RemoteViews, no
     Glance/Compose; see UptrackStatusWidgetProvider). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/uptrack_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151D28"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/uptrack_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Uptrack"
        android:textColor="#E8EEF5"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/uptrack_widget_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No ongoing incidents"
        android:textColor="#93A2B6"
        android:textSize="12sp" />

    <!-- R2.4: truthful freshness ("Updated 5m ago" / "Stale · updated 2h
         ago"); hidden when no timestamp was ever written. -->
    <TextView
        android:id="@+id/uptrack_widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#7F8FA5"
        android:textSize="10sp" />
</LinearLayout>
